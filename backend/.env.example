# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL (ganti user, password, host, port, dan nama database sesuai komputer Anda)
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/inventorywarehouse?schema=public"

# Authentication: gunakan random string panjang, minimal 32 karakter
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Full seeder (`npm run seed`)
# Password wajib memiliki minimal 12 karakter. Jangan gunakan password contoh di production.
ADMIN_EMAIL=admin@stockflow.local
ADMIN_PASSWORD=ChangeThisDemoPassword123!
DEMO_PASSWORD=ChangeThisDemoPassword123!
