# ==========================================
# STOCKFLOW BACKEND ENVIRONMENT TEMPLATE
# ==========================================

# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Number of days without an update before a document appears in the attention list (1–365).
STOCKFLOW_ATTENTION_DAYS=7
# Repeat unresolved attention notifications after this many days; 0 disables reminders.
STOCKFLOW_ATTENTION_REPEAT_DAYS=0

# PostgreSQL (sesuaikan user, password, host, port, dan database)
DATABASE_URL="postgresql://postgres:your_postgres_password@127.0.0.1:5432/inventorywarehouse?schema=public"

# Authentication: minimal 32 karakter, wajib diganti untuk production
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Persistent attachment storage. Use an absolute path outside the Git checkout in production.
ATTACHMENT_STORAGE_PATH=C:/stockflow-data/attachments
ATTACHMENT_MAX_BYTES=10485760

# ==========================================
# DEMO ACCESS SEED
# ==========================================
# Semua password minimal 12 karakter.
# Kelima akun ini dipakai oleh `npm run seed` dan `npm run seed:access`.

ADMIN_EMAIL=admin@stockflow.local
ADMIN_PASSWORD=ChangeThisAdmin123!

WAREHOUSE_MANAGER_EMAIL=warehouse.manager@stockflow.local
WAREHOUSE_MANAGER_PASSWORD=ChangeThisManager123!

WAREHOUSE_STAFF_EMAIL=warehouse.staff@stockflow.local
WAREHOUSE_STAFF_PASSWORD=ChangeThisStaff123!

PROCUREMENT_EMAIL=procurement@stockflow.local
PROCUREMENT_PASSWORD=ChangeThisProcurement123!

AUDITOR_EMAIL=auditor@stockflow.local
AUDITOR_PASSWORD=ChangeThisAuditor123!

# Fallback bila password role tertentu tidak diisi.
DEMO_PASSWORD=ChangeThisDemoPassword123!
