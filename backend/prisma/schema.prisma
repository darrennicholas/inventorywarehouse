generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// CATEGORY
// ==========================================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// BRAND
// ==========================================

model Brand {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// UNIT
// ==========================================

model Unit {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// PRODUCT
// ==========================================

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  sku         String  @unique
  code        String? @unique
  barcode     String? @unique
  name        String
  description String?
  imageUrl    String?

  minStock Int     @default(0)
  isActive Boolean @default(true)

  // FOREIGN KEYS
  categoryId String? @db.Uuid
  brandId    String? @db.Uuid
  unitId     String? @db.Uuid

  // RELATIONS
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  inventoryBalances InventoryBalance[]
  purchaseItems     PurchaseOrderItem[]
  saleItems         SaleItem[]
  adjustmentItems   StockAdjustmentItem[]
  transferItems     StockTransferItem[]
  stockMovements    StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
}

// ==========================================
// WAREHOUSE
// ==========================================

model Warehouse {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  address  String?
  isActive Boolean @default(true)

  // RELATIONS
  inventoryBalances InventoryBalance[]
  staffMembers      Staff[]
  purchaseOrders    PurchaseOrder[]
  sales             Sale[]
  adjustments       StockAdjustment[]
  transfersFrom     StockTransfer[]    @relation("TransferFromWarehouse")
  transfersTo       StockTransfer[]    @relation("TransferToWarehouse")
  expenses          Expense[]
  stockMovements    StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SUPPLIER
// ==========================================

model Supplier {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  email    String?
  phone    String?
  address  String?
  isActive Boolean @default(true)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// CUSTOMER
// ==========================================

model Customer {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  email    String?
  phone    String?
  address  String?
  isActive Boolean @default(true)

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// INVENTORY BALANCE
// ==========================================

model InventoryBalance {
  id             String @id @default(uuid()) @db.Uuid
  productId      String @db.Uuid
  warehouseId    String @db.Uuid
  quantityOnHand Int    @default(0)

  // RELATIONS
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  stockMovements StockMovement[]

  updatedAt DateTime @updatedAt

  // ONE STOCK BALANCE PER PRODUCT PER WAREHOUSE
  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

// ==========================================
// STAFF
// ==========================================

model Staff {
  id        String  @id @default(uuid()) @db.Uuid
  staffCode String  @unique
  fullName  String
  email     String? @unique
  phone     String?
  position  String?

  // FOREIGN KEY
  warehouseId String? @db.Uuid

  // RELATION
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  user      User?
  // STATUS
  isActive  Boolean    @default(true)

  // TIMESTAMPS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
}

// ==========================================
// USER
// ==========================================

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  fullName     String
  passwordHash String
  isActive     Boolean @default(true)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  staffId String? @unique @db.Uuid
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  sessions       AuthSession[]
  purchaseOrders PurchaseOrder[]
  sales          Sale[]
  adjustments    StockAdjustment[]
  transfers      StockTransfer[]
  expenses       Expense[]
  payments       Payment[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
}

// ==========================================
// ROLE
// ==========================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// PERMISSION
// ==========================================

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  roles RolePermission[]
}

// ==========================================
// ROLE PERMISSION
// ==========================================

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  // RELATIONS
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // COMPOSITE PRIMARY KEY
  @@id([roleId, permissionId])
}

// ==========================================
// AUTH SESSION
// ==========================================

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  // RELATION
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // INDEXES
  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// OPERATIONAL TRANSACTIONS
// ==========================================

enum PurchaseStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String         @id @default(uuid()) @db.Uuid
  number       String         @unique
  supplierId   String         @db.Uuid
  warehouseId  String         @db.Uuid
  createdById  String         @db.Uuid
  status       PurchaseStatus @default(DRAFT)
  orderDate    DateTime       @default(now())
  expectedDate DateTime?
  notes        String?
  subtotal     Decimal        @default(0) @db.Decimal(14, 2)
  tax          Decimal        @default(0) @db.Decimal(14, 2)
  total        Decimal        @default(0) @db.Decimal(14, 2)

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]
  payments  Payment[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([createdById])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseOrderId  String  @db.Uuid
  productId        String  @db.Uuid
  quantity         Int
  receivedQuantity Int     @default(0)
  unitPrice        Decimal @db.Decimal(14, 2)
  total            Decimal @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Sale {
  id          String     @id @default(uuid()) @db.Uuid
  number      String     @unique
  customerId  String?    @db.Uuid
  warehouseId String     @db.Uuid
  createdById String     @db.Uuid
  status      SaleStatus @default(DRAFT)
  saleDate    DateTime   @default(now())
  notes       String?
  subtotal    Decimal    @default(0) @db.Decimal(14, 2)
  discount    Decimal    @default(0) @db.Decimal(14, 2)
  tax         Decimal    @default(0) @db.Decimal(14, 2)
  total       Decimal    @default(0) @db.Decimal(14, 2)

  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     SaleItem[]
  payments  Payment[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([warehouseId])
  @@index([createdById])
  @@index([status])
  @@index([saleDate])
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2)
  total     Decimal @db.Decimal(14, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([saleId, productId])
  @@index([productId])
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

enum AdjustmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

model StockAdjustment {
  id             String           @id @default(uuid()) @db.Uuid
  number         String           @unique
  warehouseId    String           @db.Uuid
  createdById    String           @db.Uuid
  type           AdjustmentType
  status         AdjustmentStatus @default(DRAFT)
  reason         String
  adjustmentDate DateTime         @default(now())

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     StockAdjustmentItem[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@index([createdById])
  @@index([status])
}

model StockAdjustmentItem {
  id           String  @id @default(uuid()) @db.Uuid
  adjustmentId String  @db.Uuid
  productId    String  @db.Uuid
  quantity     Int
  notes        String?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, productId])
  @@index([productId])
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  number          String         @unique
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  createdById     String         @db.Uuid
  status          TransferStatus @default(DRAFT)
  transferDate    DateTime       @default(now())
  notes           String?

  fromWarehouse Warehouse           @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  createdBy     User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items         StockTransferItem[]
  movements     StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdById])
  @@index([status])
}

model StockTransferItem {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @db.Uuid
  productId  String @db.Uuid
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([productId])
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  number      String   @unique
  category    String
  description String?
  amount      Decimal  @db.Decimal(14, 2)
  warehouseId String?  @db.Uuid
  createdById String   @db.Uuid
  expenseDate DateTime @default(now())
  isPaid      Boolean  @default(false)

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@index([createdById])
  @@index([expenseDate])
}

enum PaymentType {
  PURCHASE
  SALE
  EXPENSE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  E_WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  VOID
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  number          String        @unique
  type            PaymentType
  purchaseOrderId String?       @db.Uuid
  saleId          String?       @db.Uuid
  expenseId       String?       @db.Uuid
  paidById        String        @db.Uuid
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PAID)
  paymentDate     DateTime      @default(now())
  referenceNo     String?
  notes           String?

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  sale          Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  expense       Expense?       @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  paidBy        User           @relation(fields: [paidById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([purchaseOrderId])
  @@index([saleId])
  @@index([expenseId])
  @@index([paidById])
  @@index([paymentDate])
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE_ISSUE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  productId       String            @db.Uuid
  warehouseId     String            @db.Uuid
  quantity        Int
  movementType    StockMovementType
  unitCost        Decimal?          @db.Decimal(14, 2)
  purchaseOrderId String?           @db.Uuid
  saleId          String?           @db.Uuid
  adjustmentId    String?           @db.Uuid
  transferId      String?           @db.Uuid
  createdById     String            @db.Uuid
  occurredAt      DateTime          @default(now())
  note            String?

  product            Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse          Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  purchaseOrder      PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  sale               Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  adjustment         StockAdjustment?  @relation(fields: [adjustmentId], references: [id], onDelete: SetNull)
  transfer           StockTransfer?    @relation(fields: [transferId], references: [id], onDelete: SetNull)
  createdBy          User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  inventoryBalance   InventoryBalance? @relation(fields: [inventoryBalanceId], references: [id])
  inventoryBalanceId String?           @db.Uuid

  @@index([productId, warehouseId])
  @@index([warehouseId, occurredAt])
  @@index([movementType])
}
